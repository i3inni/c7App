# ESP32 secrets.h 와 동일한 MQTT 브로커 정보
MQTT_SERVER=your-broker-host
MQTT_PORT=8883
MQTT_USER=your-mqtt-username
MQTT_PASS=your-mqtt-password

# Firebase Admin SDK 서비스 계정 키 경로
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# MQTT 데이터를 기록할 Firebase 유저 UID
# Firebase 콘솔 → Authentication → 사용자 목록에서 확인
TARGET_USER_ID=your-firebase-uid
